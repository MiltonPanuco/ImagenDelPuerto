{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imagendelpuerto",
  "main": "frontend/server/worker.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./frontend/dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
}
